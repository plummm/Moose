{
  "name": "financial_report_analyzer",
  "description": "Analyzes financial news articles scraped by news_scraper agent",
  "version": "1.0.0",
  "python_version": "3.11",
  "entry_point": "agent.py",
  "entry_class": "FinancialReportAnalyzer",
  "docker": {
    "container_suffix_name": "",
    "container_override": true,
    "ports": [
      {"container": 3501, "host": 3501}
    ],
    "environment": {
      "SCRAPER_DATA_DIR": "/data/scraper/finviz.com",
      "MOOSE_AGENT_DEBUG": "true",
      "MOOSE_AGENT_MODE": "http",
      "MOOSE_AGENT_PORT": "3501"
    },
    "volumes": [
      {
        "host": "/data/scraper/finviz.com",
        "container": "/data/scraper/finviz.com"
      }
    ],
    "resources": {
      "memory": "512m",
      "cpus": "1.0"
    }
  },
  "interactive_mode": {
    "mode": "http",
    "http_server": {
      "port": 3501,
      "auth_password": "",
      "endpoints": [
        {
          "path": "/get_financial_new",
          "method": "POST",
          "handler": "get_financial_new",
          "description": "Receive file path from news_scraper for analysis",
          "auth_required": false
        },
        {
          "path": "/queue_stats",
          "method": "GET",
          "handler": "get_queue_stats",
          "description": "Get queue statistics",
          "auth_required": false
        }
      ]
    }
  },
  "custom": {
    "llm_config": {
      "model": "gpt-5",
      "temperature": 0.7,
      "kwargs": {}
    },
    "use_langgraph": true,
    "max_concurrent_analyses": 20
  }
}
