{
  "name": "template_agent",
  "description": "Template agent showcasing Moose framework usage",
  "version": "0.1.0",
  "python_version": "3.11",
  "entry_point": "agent.py",
  "entry_class": "TemplateAgent",
  "interactive_mode": {
    "mode": "http",
    "http_server": {
      "port": 3509,
      "auth_password": "",
      "endpoints": [
        {
          "path": "/process",
          "method": "POST",
          "handler": "process",
          "description": "Sync wrapper around LLM analysis",
          "auth_required": false
        },
        {
          "path": "/analyze",
          "method": "POST",
          "handler": "analyze",
          "description": "Async LLM analysis",
          "auth_required": false
        },
        {
          "path": "/health",
          "method": "GET",
          "handler": "health",
          "description": "Health check",
          "auth_required": false
        },
        {
          "path": "/status",
          "method": "GET",
          "handler": "status_page",
          "description": "HTML status page",
          "auth_required": false
        }
      ]
    }
  },
  "custom": {
    "llm": {
      "$include": "prompts/llm/agent_config.json"
    }
  },
  "docker": {
    "container_suffix_name": "",
    "container_override": true,
    "ports": [
      { "container": 3509, "host": 3509 }
    ],
    "environment": {
      "MOOSE_AGENT_MODE": "http",
      "MOOSE_AGENT_PORT": "3509",
      "MOOSE_PROJECT_ID": "default",
      "MOOSE_PROJECTS_DIR": "/app/projects",
      "OPENAI_API_KEY": ""
    },
    "volumes": [
      { "host": "./projects", "container": "/app/projects" }
    ],
    "resources": {
      "memory": "512m",
      "cpus": "0.5"
    }
  }
}
